# Local orchestrator (LM Studio — default backend).
# Point at an LM Studio server running locally (or on your LAN).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Leave empty to use whichever model is currently loaded in LM Studio,
# or pin to a specific model identifier (e.g. "qwen2.5-7b-instruct").
LMSTUDIO_MODEL=local-model

# Specialist providers. Missing keys are fine — the dispatcher falls
# back to the local model when a specialist has no credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
